# --- Postgres (use the Neon pooled URL at runtime, direct URL for migrations) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

PORT=4000

# --- Auth / tokens (JWT_SECRET must be at least 32 characters) ---
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="30d"
JWT_ISSUER="cahier-app"
JWT_AUDIENCE="cahier-app-clients"

# --- CORS (comma-separated allowed browser origins) ---
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081"

# --- Auth rate limiting ---
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_MAX=30

# --- Seed super admin ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-this-password"
